{
  // markdownlint-cli2 configuration for the logbook.
  // Rule reference: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    "default": true,
    // Prose lines wrap naturally; don't enforce a hard line length.
    "MD013": false,
    // Allow repeated headings under different parents (e.g. "Notes" per section).
    "MD024": { "siblings_only": true },
    // Cosmetic; don't enforce asterisk vs. underscore for emphasis/strong.
    "MD049": false,
    "MD050": false,
    // Cosmetic; don't require padding spaces around table pipes.
    "MD060": false
  },
  // Entry assets are archived verbatim (docs written elsewhere); lint only the
  // entry READMEs and other first-party prose.
  "ignores": ["node_modules", "entries/*/assets/**/*.md"]
}
