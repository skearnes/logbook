{
  // markdownlint-cli2 configuration for the logbook.
  // Rule reference: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    "default": true,
    // Prose lines wrap naturally; don't enforce a hard line length.
    "MD013": false,
    // Allow repeated headings under different parents (e.g. "Notes" per section).
    "MD024": { "siblings_only": true }
  },
  "ignores": ["node_modules"]
}
